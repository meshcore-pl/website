<% if (locals.footer !== false) { %>
	<footer id="footer">
		<div id="footer__inner">
			<div id="footer__top">
				<div id="footer__brand">
					<img src="/images/logo/wordmark.png" alt="MeshCore Polska" width="264" height="16">
				</div>
				<nav id="footer__links" aria-label="Stopka">
					<div class="footer__group">
						<p class="footer__group-title">Sieć</p>
						<a href="https://mapa.meshcorepolska.org" target="_blank" rel="noopener">Mapa węzłów</a>
						<a href="/statystyki">Statystyki</a>
						<a href="/generator-regionow">Generator regionów</a>
					</div>
					<div class="footer__group">
						<p class="footer__group-title">Zasoby</p>
						<a href="https://docs.meshcorepolska.org" target="_blank" rel="noopener">Oficjalna dokumentacja</a>
						<a href="https://meshcore.io" target="_blank" rel="noopener">Oficjalna witryna projektu</a>
						<a href="https://www.dxinfocentre.com/tropo_eur.html" target="_blank" title="Prognoza propagacji troposferycznej fal radiowych" rel="noopener nofollow">Prognoza propagacji</a>
					</div>
					<div class="footer__group">
						<p class="footer__group-title">Społeczność</p>
						<a href="/discord" target="_blank" rel="noopener">Discord</a>
						<a href="https://github.com/meshcore-pl" target="_blank" rel="noopener nofollow">GitHub</a>
						<a href="/kontakt">Kontakt</a>
					</div>
					<div class="footer__group">
						<p class="footer__group-title">Informacje</p>
						<a href="/polityka-prywatnosci">Polityka prywatności</a>
						<a href="/llms.txt" title="Notka dla agentów AI (plik llms.txt)">Instrukcje AI</a>
					</div>
				</nav>
			</div>
			<div id="footer__bottom">
				<p id="footer__copy">Copyright 2026 &copy; by <a href="https://sefinek.net" target="_blank" rel="noopener">Sefinek</a>. Licencja <a href="https://github.com/meshcore-pl/website/blob/main/LICENSE" target="_blank" rel="noopener">PolyForm Noncommercial 1.0.0</a>.</p>
				<p id="footer__meta">Preset EU/UK (Narrow) &middot; 869,618 MHz &middot; 62,5 kHz &middot; SF8 &middot; CR8</p>
			</div>
		</div>
	</footer>
<% } %>
<% if (locals.outro) { %></div><% } %>

<script src="/js/nav.js" defer></script>
<% (locals.scripts || []).forEach(src => { %><script src="<%= src %>" defer></script><% }) %>
<script src="https://cdn.sefinek.net/js/console.js" data-start-year="2026" data-license="PolyForm Noncommercial 1.0.0" defer></script>
</body>
</html>
