<%- include('./includes/header.ejs', {
	title: 'Kontakt | MeshCore Polska',
	description: 'Formularz kontaktowy MeshCore Polska - pytania o sprzęt, konfigurację lub współpracę. Odpowiadamy najszybciej, jak to możliwe, zwykle w ciągu kilku dni.',
	canonical: '/kontakt',
	css: 'contact',
	page: 'contact'
}) %>

<main>
	<section class="section section--kontakt" aria-labelledby="kontakt-heading">
		<div class="section__inner" id="contact-inner">
			<p class="eyebrow">Napisz do nas</p>
			<h1 id="kontakt-heading">Formularz kontaktowy</h1>
			<p id="contact-lead">
				Masz pytanie, sugestię albo problem techniczny? Napisz bezpośrednio do nas.
				Możesz też skorzystać z <a href="/discord" target="_blank" rel="noopener">Discorda</a> albo napisać na <a href="mailto:contact@sefinek.net">contact@sefinek.net</a>.
			</p>

			<div id="contact-card">
				<form id="contact-form" method="post" action="/api/v1/kontakt">
					<div class="contact-form__field">
						<label for="username">Nazwa użytkownika</label>
						<input type="text" id="username" name="username" value="<%= values.username %>" minlength="2" maxlength="64" required>
					</div>

					<div class="contact-form__field">
						<label for="email">Adres e-mail</label>
						<input type="email" id="email" name="email" value="<%= values.email %>" maxlength="254" required>
					</div>

					<div id="contact-form__hp" aria-hidden="true">
						<label for="website">Strona internetowa</label>
						<input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
					</div>

					<div class="contact-form__field">
						<label for="message">Wiadomość</label>
						<textarea id="message" name="message" rows="7" minlength="10" maxlength="4000" required><%= values.message %></textarea>
					</div>

					<button type="submit" class="btn btn--primary">Wyślij wiadomość</button>
					<div id="contact-turnstile" data-sitekey="<%= process.env.TURNSTILE_SITEKEY %>" hidden></div>
				</form>
			</div>

			<% if (tip) { %><div class="docs-tip"><svg class="docs-tip__icon" aria-hidden="true"><use href="/icons.svg#alert-tip"></use></svg><p><%= tip %></p></div><% } %>
		</div>
	</section>
</main>

<template id="contact-notifications" data-sent="<%= locals.sent ? '1' : '0' %>"><% errors.forEach(error => { %><p><%= error %></p><% }) %></template>
<script type="module" src="/js/contact.js"></script>

<%- include('./includes/footer.ejs') %>
