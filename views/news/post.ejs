<%- include('../includes/header.ejs', {
title,
description,
canonical,
css: ['https://cdn.sefinek.net/css/code-viewer.css', 'content', 'docs', 'news'],
page: 'news',
breadcrumbs,
articleType: 'BlogPosting',
datePublished: post.publishedAt.toISOString().slice(0, 10),
dateModified: post.date.toISOString().slice(0, 10)
}) %>

<main>
	<section class="news-hero news-hero--post">
		<div class="section__inner">
			<nav class="docs-breadcrumb" aria-label="Okruszki">
				<a href="/aktualnosci">Aktualności</a>
				<span aria-hidden="true">/</span>
				<% if (post.tagSlug) { %><a href="/aktualnosci/<%= post.tagSlug %>"><%= post.tags[0].label %></a>
				<span aria-hidden="true">/</span>
				<% } %>
				<span aria-current="page"><%= post.title %></span>
			</nav>
		</div>
	</section>

	<section class="section">
		<div class="section__inner">
			<article class="news-content prose">
				<%- post.html %>
			</article>

			<div id="news-post__footer">
				<a href="/aktualnosci" class="btn btn--secondary"><svg class="docs-pagination__icon" aria-hidden="true"><use href="/icons.svg#arrow-left"></use></svg> Wróć do aktualności</a>

				<div id="news-post__meta">
					<span class="news-post-card__date"><%= post.updatedAt ? `Zaktualizowano: ${post.updatedAt}` : `Opublikowano: ${post.createdAt}` %></span>
					<div class="news-post-card__tags">
						<div class="news-post-card__tags-list">
							<% post.tags.forEach(tag => { %><a href="/aktualnosci/<%= tag.slug %>" class="news-tag"><%= tag.label %></a><% }) %>
						</div>

						<% if (post.sourceUrl) { %>
						<a href="<%= post.sourceUrl %>" class="news-source news-source--<%= post.source.slug %>" title="Zobacz oryginalny wpis na <%= post.source.label %>" target="_blank" rel="noopener nofollow"><%= post.source.label %></a>
						<% } else { %>
						<span class="news-source news-source--<%= post.source.slug %>" title="<%= post.source.description %>"><%= post.source.label %></span>
						<% } %>
					</div>
				</div>
			</div>
		</div>
	</section>
</main>

<%- include('../includes/footer.ejs', { footer: false, scripts: ['/js/lightbox.js'] }) %>
